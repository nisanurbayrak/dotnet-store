@model IEnumerable<AppRole>
@{
    Layout = "_AdminLayout";
}
<div class="row">
    <div class="col">
      <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span>Roles</span>
          <div class="d-flex ms-auto gap-3">
            <a
            asp-action="Create"
            class="btn btn-custom"
            title="Add New Roles"
            >
            <i class="fa-solid fa-plus"></i>
            </a>
          </div>
          
        </div>
        @if (TempData["Error"] != null)
{
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    @TempData["Error"]
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
}

        <div class="card-body bg-white rounded-bottom-4">
          <div class="table-responsive">
            <table id="myTable">
              <thead>
                <tr>
                  <th>Role Name</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                @foreach (var item in Model) {
                <tr>
                  <td class="fw-semibold text-start">@item.Name</td>
                  <td class="text-center">
                    <a
                      asp-action="Edit"
                      asp-route-id="@item.Id"
                      class="btn btn-outline-primary btn-sm me-1" 
                    >
                      <i class="fa-solid fa-pen-to-square"></i>
                    </a>

                    <button
                      href="javascript:void(0);"
                      class="btn btn-outline-danger btn-sm me-1"                       
                      onclick="openDeleteModal('@item.Name')"
                    >
                      <i class="fa-solid fa-trash"></i>
                    </button>
                    <form
                      method="post"
                      asp-action="DeleteConfirm"
                      style="display: none"
                    >
                    </form>
                  </td>
                </tr>
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content rounded-4 shadow-sm border-0">
        <form
          id="deleteForm"
          method="post"
          asp-controller="Role"
          asp-action="DeleteConfirm"
        >
          <div class="modal-header">
            <h5 class="modal-title">Delete Confirmation</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body">
            <p id="deleteMessage"></p>
            <input type="hidden" name="Id" id="deleteId" />
          </div>
          <div class="modal-footer">
            <button type="submit" class="btn btn-danger">Delete</button>
            <button
              type="button"
              class="btn btn-secondary"
              data-bs-dismiss="modal"
            >
              Cancel
            </button>
          </div>
        </form>
      </div>
    </div>
  </div> 
@section Scripts {
    <script>
      function openDeleteModal(id, name) {
      document.getElementById('deleteId').value = id;
      document.getElementById('deleteMessage').textContent = `Warning: You are deleting the "${name}" role permanently. This action cannot be reversed.`;
      var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
      modal.show();       

       window.onload = function () {
        var error = '@TempData["Error"]';
        if (error) {
          document.getElementById('errorModalMessage').textContent = error;
          var errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
          errorModal.show();
        }
      }
    </script>

     @await Html.PartialAsync("_ValidationScriptsPartial")

    }