@model RoleCreateModel
@{
    Layout ="_AdminLayout";
}
  <div class="row">
            <div class="col">
                <div class="card shadow rounded-4">
                   <div class="card-header d-flex justify-content-between align-items-center">
        <span>Create Role</span>
        <div class="d-flex gap-3 ms-auto">
          <a
            asp-action="Index"
            class="btn btn-sm btn-custom"
            title="Role List">
            <i class="fa-solid fa-list"></i>
          </a>
        </div>
      </div>
                    <div class="card-body">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <form method="post" asp-controller="Role" asp-action="Create">
                            <div class="row mb-3">
                                <label asp-for="RoleName" name="RoleName" class="col-sm-2 col-form-label"></label>
                                <div class="col-sm-10">
                                    <input asp-for="RoleName" class="form-control">
                                    <span asp-validation-for="RoleName" class="text-danger"></span>
                                </div>
                            </div>
                           
                                <div class="col-sm-4 d-flex justify-content-end ">
                                    <button type="submit" class="btn btn-custom w-75 justify-content-center">Save</button>
                                </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>